# Cloudflare Pages _redirects
# Rewrite dynamic routes ke pre-rendered static shell
# Client-side Next.js membaca params melalui useSearchParams() atau window.location

# Builder
/builder/*  /builder/default/index.html  200

# Public form runner
/f/*  /f/index.html  200

# Responses
/dashboard/forms/*/responses  /dashboard/forms/default/responses/index.html  200
/dashboard/forms/*/responses/  /dashboard/forms/default/responses/index.html  200
